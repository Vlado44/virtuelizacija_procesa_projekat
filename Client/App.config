<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.serviceModel>
    <client>
      <endpoint
        name ="EegService"
        address="net.tcp://localhost:9000/EegService"
        binding="netTcpBinding"
        bindingConfiguration ="EegTcpBinding"
        contract="Common.IEegService"/>
    </client>

    <bindings>
      <netTcpBinding>
        <binding
          name="EegTcpBinding"
          transferMode="Buffered"
          maxReceivedMessageSize="10485760"
          openTimeout="00:01:00"
          closeTimeout="00:01:00"
          sendTimeout ="00:05:00"
          receiveTimeout ="00:10:00"/>
      </netTcpBinding>
    </bindings>
  </system.serviceModel>
  
  
  
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>