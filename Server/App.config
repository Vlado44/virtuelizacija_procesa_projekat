<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="BatteryLowThreshold" value ="20"/>
    <add key="ContactQualityMin" value="70"/>
    <add key="AttentionSpikeThreshold" value="25"/>
    <add key="ChannelOutOfBandPct" value="25"/>
    <add key="TimestampSkewMaxMs" value="1000"/>
    <add key="DataRoot" value=""/>
  </appSettings>
  
  <system.serviceModel>
    <services>
      <service name="Server.EegService">
        <host>
          <baseAddresses>
            <add baseAddress = "net.tcp://localhost:9000/EegService" />
          </baseAddresses>
        </host>

        <endpoint
          address=""
          binding ="netTcpBinding"
          bindingConfiguration="EegTcpBinding"
          contract ="Common.IEegService"/>
          
      </service>  
    </services>
    
    <bindings>
      <netTcpBinding>
        <binding
          name ="EegTcpBinding"
          transferMode ="Buffered"
          maxReceivedMessageSize ="10485760"
          openTimeout ="00:01:00"
          closeTimeout="00:01:00"
          sendTimeout="00:05:00"
          receiveTimeout="00:10:00"/>
          
      </netTcpBinding>
    </bindings>
  </system.serviceModel>
  
  
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>